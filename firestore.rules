rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필: 누구나 읽기, 로그인한 본인만 쓰기
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId;

      // 사용자 링크: 누구나 읽기, 로그인한 본인만 쓰기
      match /links/{linkId} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // 명시하지 않은 경로는 기본적으로 접근 차단
  }
}
