rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필: 누구나 읽기, 로그인한 본인만 쓰기
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId;
      // 이미 지정한 displayname은 수정하거나 제거할 수 없음
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (resource.data.get('displayname', null) == null
          || request.resource.data.get('displayname', null) == resource.data.displayname);
      // 삭제 후 재생성으로 아이디를 변경하는 것도 차단
      allow delete: if false;

      // 공개 링크 클릭은 서버에서 1씩 증가, 나머지 수정은 본인만 허용
      match /links/{linkId} {
        allow read: if true;
        allow create, delete: if request.auth != null
          && request.auth.uid == userId;
        allow update: if (request.auth != null && request.auth.uid == userId)
          || (resource.data.get('visible', false) == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
            && request.resource.data.clickCount is int
            && request.resource.data.clickCount == resource.data.get('clickCount', 0) + 1);
      }
    }

    // 명시하지 않은 경로는 기본적으로 접근 차단
  }
}
