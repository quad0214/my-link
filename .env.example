NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
# Optional: leave empty to skip Analytics initialization.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Production origin for canonical URLs, Open Graph images, robots.txt, and sitemap.xml.
# Set this to the real public domain before deploying (e.g. https://mylink.example.com).
# Vercel automatically falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
